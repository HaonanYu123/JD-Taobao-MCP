# 默认弹出可见浏览器，便于你自己扫码、登录和处理验证码。
PLAYWRIGHT_HEADLESS=false

# 留空时使用 Playwright 自带 Chromium；Windows 也可填 msedge 或 chrome。
BROWSER_CHANNEL=
BROWSER_EXECUTABLE_PATH=
JD_BROWSER_EXECUTABLE_PATH=
TAOBAO_BROWSER_EXECUTABLE_PATH=
TAOBAO_SEARCH_MODE=mobile

# 独立浏览器资料目录。不要指向你日常 Chrome/Edge 的默认用户目录。
BROWSER_PROFILE_DIR=~/.jd-taobao-browser-mcp/browser-profile
ARTIFACTS_DIR=~/.jd-taobao-browser-mcp/artifacts
PLAYWRIGHT_BROWSERS_PATH=.ms-playwright

NAVIGATION_TIMEOUT_MS=45000
ACTION_TIMEOUT_MS=15000
ACTION_DELAY_MS=700
SLOW_MO_MS=80
MAX_PAGE_TEXT_CHARS=18000
MAX_SEARCH_RESULTS=30

# 默认禁止加入购物车、购买、结算、支付、删除、关注等状态变更动作。
# 本项目定位是页面浏览与数据提取，不建议开启。
ALLOW_STATE_CHANGING_ACTIONS=false

# 可选代理，例如 http://127.0.0.1:7897
PROXY=
